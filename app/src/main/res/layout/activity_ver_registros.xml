
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    tools:ignore="HardcodedText"
    tools:context=".Vista.VerRegistrosActivity">

    <!-- ENCABEZADO -->
    <LinearLayout
        android:id="@+id/encabezadoEstado"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="#15558B"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="ESTADO DE INSCRIPCIONES"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- CONTENIDO PRINCIPAL -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F4F7FB"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/encabezadoEstado"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- FILTRO DE CARRERAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="4dp">

            <Spinner
                android:id="@+id/spnCarrerasEstado"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:spinnerMode="dropdown" />

        </LinearLayout>

        <!-- TOTAL DE INSCRIPCIONES -->
        <TextView
            android:id="@+id/txtTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:gravity="end"
            android:textColor="#172B4D"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- LISTA DINÁMICA DE INSCRIPCIONES -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEstado"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="12dp"
            android:clipToPadding="false"
            android:padding="4dp"
            android:scrollbars="vertical"
            tools:listitem="@android:layout/simple_list_item_1" />

        <!-- BOTÓN VOLVER AL CATÁLOGO -->
        <Button
            android:id="@+id/btnVolverCatalogo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#15558B"
            android:text="VOLVER AL CATÁLOGO"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
