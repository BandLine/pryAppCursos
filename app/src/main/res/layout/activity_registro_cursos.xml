
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#15558B"
    tools:ignore="HardcodedText"
    tools:context=".RegistroCursosActivity">

    <!-- ENCABEZADO -->
    <LinearLayout
        android:id="@+id/encabezadoRegistro"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="#15558B"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REGISTRO AL CURSO"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- CONTENIDO -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F4F7FB"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/encabezadoRegistro"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- INSCRIPCIÓN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="INSCRIPCIÓN:"
                android:textColor="#172B4D"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- INFORMACIÓN DEL CURSO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#E4E9F0"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:elevation="2dp">

                <ImageView
                    android:id="@+id/imgCursoRegistro"
                    android:layout_width="96dp"
                    android:layout_height="70dp"
                    android:background="#D5E0EB"
                    android:scaleType="centerCrop"
                    android:contentDescription="Imagen del curso" />

                <TextView
                    android:id="@+id/txtCursoRegistro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:textColor="#172B4D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- MATRÍCULA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="MATRÍCULA DEL ALUMNO:"
                android:textColor="#172B4D"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etMatricula"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:hint="Ingrese su matrícula"
                android:inputType="number"
                android:maxLength="15"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#172B4D"
                android:textColorHint="#94A3B8"
                android:textSize="17sp" />

            <!-- FECHA DE REGISTRO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="FECHA DE REGISTRO:"
                android:textColor="#172B4D"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etFecha"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:cursorVisible="false"
                android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                android:focusable="false"
                android:hint="Seleccione una fecha"
                android:inputType="none"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#172B4D"
                android:textColorHint="#94A3B8"
                android:textSize="17sp" />

            <!-- CORREO INSTITUCIONAL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="CORREO INSTITUCIONAL:"
                android:textColor="#172B4D"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:hint="Ingrese su correo institucional"
                android:inputType="textEmailAddress"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#172B4D"
                android:textColorHint="#94A3B8"
                android:textSize="17sp" />

            <!-- CONFIRMAR INSCRIPCIÓN -->
            <Button
                android:id="@+id/btnConfirmar"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="#099653"
                android:text="CONFIRMAR INSCRIPCIÓN"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />

            <!-- CANCELAR -->
            <Button
                android:id="@+id/btnCancelar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#E0E4E8"
                android:text="CANCELAR"
                android:textAllCaps="false"
                android:textColor="#172B4D"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
